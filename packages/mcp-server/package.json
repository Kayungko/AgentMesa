{
  "name": "@agentmesa/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "AgentMesa Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentmesa/agentmesa",
    "directory": "packages/mcp-server"
  },
  "keywords": ["agentmesa", "ai-agents", "claude-code", "codex", "mcp"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mesa-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentmesa/connector-github": "workspace:*",
    "@agentmesa/core": "workspace:*",
    "@agentmesa/orchestrator": "workspace:*",
    "@agentmesa/protocol": "workspace:*",
    "@agentmesa/runner": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
