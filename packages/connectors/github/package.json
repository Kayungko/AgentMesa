{
  "name": "@agentmesa/connector-github",
  "version": "0.1.0",
  "description": "GitHub PR linking, diff import, review artifact export, CI result import, and discussion import connector for AgentMesa",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentmesa/core": "workspace:*",
    "@agentmesa/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
