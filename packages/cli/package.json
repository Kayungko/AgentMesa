  },
  "dependencies": {
    "@agentmesa/core": "workspace:*",
    "@agentmesa/orchestrator": "workspace:*",
    "@agentmesa/protocol": "workspace:*",
    "@agentmesa/runner": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
